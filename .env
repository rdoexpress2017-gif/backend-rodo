# Configuração de Ambiente - RDO Express
# Quando SEED_SAMPLE_DATA=false (padrão seguro de produção), apenas o login inicial (admin@rodo.com) e configurações globais são criados.
# Quando SEED_SAMPLE_DATA=true, também popula massa de testes (Clientes, Motoboys e Pedidos) caso o banco esteja vazio.
SEED_SAMPLE_DATA=false
MONGODB_URI=mongodb://localhost:27017/rodo_express
JWT_SECRET=rodo-express-hyperplane-secret-key-2026-ultra-secure-256bit
JWT_EXPIRATION_HOURS=24
